# Copy to .env. Never commit .env.
ENV=development
PORT=8080
LOG_LEVEL=debug
# Host port 5435 avoids clashing with a local Postgres on 5432.
DATABASE_URL=postgres://app:app@localhost:5435/app?sslmode=disable
DB_PORT=5435
# "key:principal" pairs. The principal scopes the caller's data.
API_KEYS=dev-key:dev
CORS_ORIGINS=http://localhost:5173
# Direct peers whose X-Forwarded-For header is trusted (comma separated IPs)
TRUSTED_PROXIES=
RATE_LIMIT_PER_MINUTE=120
SHUTDOWN_TIMEOUT=10s
# Apply migrations on boot (the Docker image sets this to true)
MIGRATE_ON_START=false
# Optional: set to enable OpenTelemetry traces (e.g. http://localhost:4318/v1/traces)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Optional: run integration tests against an existing database instead of a Testcontainer
TEST_DATABASE_URL=
# Optional: multi-model council review
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
